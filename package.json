{
  "name": "qr-folio",
  "productName": "QR Folio",
  "version": "1.3.2",
  "description": "QR Folio — classic QR first, then logo, colors, and frame.",
  "author": "elieli1269",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable nsis --x64 --publish never",
    "build:store": "electron-builder --win appx --x64 --publish never"
  },
  "devDependencies": {
    "electron": "35.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.qrfolio.code",
    "productName": "QR Folio",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["index.html", "app.js", "styles.css", "electron/**/*", "package.json"],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "QR Folio",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "QR-Folio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "QR-Folio-${version}-portable.exe"
    },
    "appx": {
      "applicationId": "QRFolio",
      "identityName": "Elieli1269.QRFolio",
      "publisher": "CN=F30B755C-8F1E-43A8-B6E4-EAB3FA748AEB",
      "publisherDisplayName": "Elieli1269",
      "displayName": "QR Folio",
      "backgroundColor": "#0F172A",
      "languages": ["fr-FR", "en-US"],
      "showNameOnTiles": true,
      "artifactName": "QR-Folio-${version}.${ext}"
    }
  }
}
