{
  "name": "generateur-qr-code",
  "productName": "Generateur QR Code",
  "version": "1.0.0",
  "description": "Generateur de codes QR personnalisables — liens, mots-cles, logo, cadres.",
  "author": "elieli1269",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "35.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.generateurqr.code",
    "productName": "Generateur QR Code",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Generateur QR Code",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Generateur-QR-Code-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Generateur-QR-Code-${version}-portable.exe"
    }
  }
}
